+// ---- FSCAA LAYER 1: CMAA2 AFTER THE RESOLVE (taa.backend=fscaa, fscaa.h).
+// It cleans the frame being DELIVERED - never the history, never the resolve's input. Its first home
+// was before the resolve, on the jittered frame: there it judged each frame's edges at a different
+// sub-pixel offset, its blends changed from frame to frame, and the resolve's colour clamp threw
+// history away over them - far runway markings and terminal edges flickered (first live run,
+// 2026-10-15). On the resolved frame its input is stable, and it only finds work where history could
+// not do it: class-capped pixels and disocclusions. In place on the sharpen target (ours, already
+// STORAGE) when the sharpen runs; otherwise on a copy, because the delivery source is then the
+// history itself. Returns the image the copy-out should deliver - src (in place), the cleaned copy
+// (left in SHADER_READ_ONLY_OPTIMAL), or VK_NULL_HANDLE when CMAA2 did not run. Layer 2 (class caps)
+// is in taa.comp, driven by slots 32-39.
+static cmaa2::Fns   g_cmaaFns;
+static cmaa2::State g_cmaa;
+static std::mutex   g_cmaaMtx;
+static bool         g_cmaaFnsOk = false, g_cmaaFailed = false;
+static uint64_t     g_fscaaFrame = 0;
+static uint32_t     g_fscaaCtr[16] = {};
+
+static VkImage fscaaRecordCmaa(DeviceData &dd, VkCommandBuffer cb, VkImage src, bool srcIsScratch)
+{
+    const fscaa::Settings s = fscaa::read();
+    if (!s.on) return VK_NULL_HANDLE;
+    ++g_fscaaFrame;
+    const bool statsFrame = s.statsEvery > 0 && (g_fscaaFrame % (uint64_t)s.statsEvery) == 0;
+    VkImage out = VK_NULL_HANDLE;
+    if (!(s.layers & fscaa::kCmaa)) fscaa::skipOnce("fscaa.layers excludes CMAA2 (bit 1)");
+    else if (g_taa.layers != 1)    fscaa::skipOnce("multi-layer (VR) scene - FSCAA is single-view only");
+    else if (!src)                 fscaa::skipOnce("no delivery image this frame");
+    else if (g_taa.format != VK_FORMAT_R16G16B16A16_SFLOAT) fscaa::skipOnce("scene is not RGBA16F - CMAA2's views are built for that format");
+    else if (!g_cmaaFailed) {
+        std::lock_guard<std::mutex> g(g_cmaaMtx);
+        if (!g_cmaaFnsOk) {
+            VkPhysicalDeviceMemoryProperties mp; memset(&mp, 0, sizeof(mp));
+            if (g_getPhysMemProps && dd.phys) g_getPhysMemProps(dd.phys, &mp);
+            g_cmaaFnsOk = dd.gdpa && cmaa2::loadFns(g_cmaaFns, dd.gdpa, g_taa.device, mp);
+            if (!g_cmaaFnsOk) { g_cmaaFailed = true; fscaa::skipOnce("CMAA2 entry points missing"); }
+        }
+        const bool inplace = srcIsScratch;
+        // The sharpen target is rebuilt with the rest of the TAA state (resize, flight change), so a
+        // view cached on the previous one is stale. Rare: wait for idle and start clean.
+        const bool stale = inplace && !g_cmaa.ext.empty() && !g_cmaa.ext.count(src);
+        if (g_cmaaFnsOk && (g_cmaa.w != g_taa.w || g_cmaa.h != g_taa.h || !g_cmaa.pl || g_cmaa.ownColor == inplace || stale)) {
+            if (g_cmaa.dev && dd.deviceWaitIdle) dd.deviceWaitIdle(g_taa.device);   // nothing in flight may use the old set
+            if (!cmaa2::create(g_cmaaFns, g_cmaa, g_taa.device, g_taa.w, g_taa.h, !inplace)) {
+                g_cmaaFailed = true;
+                trace("FSCAA: CMAA2 resources for %ux%u FAILED - running the class caps without it", g_taa.w, g_taa.h);
+            } else {
